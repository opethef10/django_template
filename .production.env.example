PROJECT_SLUG= # Project slug for pythonanywhere.com and docker image, lowercase, no spaces
PROJECT_NAME= # Project Name that will be displayed on the website's navbar
PROJECT_DESCRIPTION= # Project Description that will be displayed on the website's footer
PROJECT_DOMAIN= # Project Domain that will be used for the website's URL
PROJECT_PORT_PROD=8000 # Port number for the Docker image, default is 8000

DJANGO_SECRET_KEY= # A randomly generated 50 character long string, use command `python scripts/generate_secret_key.py` to generate one

# --- Email ---
# Master switch. When False, no real mail is configured.
DJANGO_EMAIL_ENABLED=False

# Backend: "smtp" (Gmail) or "anymail" (any Anymail ESP)
DJANGO_MAIL_BACKEND=smtp

# Gmail SMTP (used when DJANGO_MAIL_BACKEND=smtp)
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER= # you@gmail.com
DJANGO_EMAIL_HOST_PASSWORD= # Gmail App Password (not your Gmail password)
DJANGO_EMAIL_USE_TLS=True
DJANGO_SERVER_EMAIL= # you@gmail.com
DJANGO_DEFAULT_FROM_EMAIL= # you@gmail.com (defaults to DJANGO_SERVER_EMAIL if unset)

# Anymail (used when DJANGO_MAIL_BACKEND=anymail)
# AnyMail provider: mailjet, mailgun, sendgrid, postmark, resend, amazon_ses,
# mandrill, brevo, mailtrap, sparkpost, postal, mailersend, unisender_go, scaleway
# Full list: https://anymail.dev/en/stable/esps/
#ANYMAIL_PROVIDER=mailjet
# JSON object passed as MAILERS default OPTIONS to the Anymail backend.
# Keys depend on the provider — see provider docs linked above.
# Mailjet example:
#ANYMAIL_OPTIONS={"api_key":"YOUR_KEY","secret_key":"YOUR_SECRET_KEY"}

# Comma-separated list for Django error emails (ADMINS)
PROJECT_ADMIN_EMAILS= # admin@example.com

DJANGO_ALLOWED_HOSTS= # yourwebsite.com

ACCOUNT_ALLOW_SIGNUPS=True

RECAPTCHA_ENABLED=False
RECAPTCHA_PUBLIC_KEY= # RECAPTCHA_PUBLIC_KEY
RECAPTCHA_PRIVATE_KEY= # RECAPTCHA_PRIVATE_KEY
